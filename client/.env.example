# client/.env — Vite only exposes VITE_-prefixed vars, and only these are
# ever safe to ship: Firebase web config is a public identifier, not a
# secret (see docs/KEYS-TODO.md / PLAN.md §機敏資訊政策). Server-only
# secrets (RENAISS_INDEX_API_KEY/SECRET, BSC_RPC_URL, GCP_SERVICE_ACCOUNT_
# BASE64) belong in server/.env.example, never here.

# --- Firebase (Auth gates Version B inventory only; Version A/Dashboard
#     works with no login) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
