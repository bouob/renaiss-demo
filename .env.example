# Renaiss Merchant Copilot — server env template.
# Copy to `.env` (repo root) and fill in real values from the deploy secret
# store. NEVER commit `.env` — see .gitignore. Every entry below is a
# placeholder; real values are tracked in docs/KEYS-TODO.md.

# --- Renaiss OS Index partner API (server-only; never in client bundle) ---
# Graded-cert FMV lookups (getGradedFmv) + index/movers endpoints
# (getIndices/getIndexDetail/getCardFmvSeries). Missing key → fail-open null,
# never a network call (see server/services/renaissOsIndex.js).
RENAISS_INDEX_API_KEY=REPLACE_ME_RENAISS_INDEX_API_KEY
RENAISS_INDEX_API_SECRET=REPLACE_ME_RENAISS_INDEX_API_SECRET

# --- BNB Smart Chain RPC (server-only; typically an Alchemy URL with an ---
# --- embedded API key) — used by chainAdapters/bsc/renaissAdapter.js for ---
# --- wallet scan (fetchHoldings/fetchNFTAttributes). Missing → fail-open ---
# --- empty holdings.
BSC_RPC_URL=https://REPLACE_ME_BSC_RPC_HOST/REPLACE_ME_API_KEY

# --- Firebase Admin SDK service account (Dokipoki dev Firebase project; ---
# --- base64-encoded service-account JSON). Server-only, never in client ---
# --- bundle. Used by Firestore-backed routes (/meta →
# --- hackathonMerchantInventory/{uid}) via Admin SDK (bypasses
# --- firestore.rules — treat as highly privileged).
GCP_SERVICE_ACCOUNT_BASE64=REPLACE_ME_BASE64_ENCODED_SERVICE_ACCOUNT_JSON

# --- Google Gemini (server-only; never in client bundle) ---
# AI merchant advice — personalized promote/hold/clear explanation
# (routes/insight.js → services/geminiMerchantService.js), cached 24h per cert.
# Missing key → 503 gemini_unconfigured (only a stale cache hit degrades softly).
GEMINI_API_KEY=REPLACE_ME_GEMINI_API_KEY
# Optional model override; default chain tries gemini-2.5-flash-lite →
# gemini-2.0-flash-lite → gemini-2.0-flash (see geminiMerchantService.js).
# GEMINI_MODEL=gemini-2.5-flash-lite

# --- CORS (production) ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=https://dokipoki-dev.web.app,https://merchant.dokipoki.app

# --- Local dev only ---
# Set to "true" to make server/index.js call app.listen() locally
# (Cloud Function environments must never set this).
IS_LOCAL_DEV=false
PORT=3101
