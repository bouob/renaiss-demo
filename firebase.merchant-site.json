{
  "hosting": {
    "site": "merchant-dokipoki-dev",
    "public": "client/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "merchantApi",
        "region": "asia-east1"
      },
      {
        "source": "/merchant/api/**",
        "function": "merchantApi",
        "region": "asia-east1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
